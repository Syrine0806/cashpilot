# SQLite file (relative to prisma/schema.prisma). Use a PostgreSQL URL in production (see README).
DATABASE_URL="file:./dev.db"
# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
# Time zone used to decide what "today" is for due dates and forecasts.
APP_TIMEZONE="Africa/Tunis"
# Where uploaded receipts (justificatifs) are stored. Never inside /public.
UPLOAD_DIR="./storage/receipts"
